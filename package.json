{
  "name": "sine-si-sosele",
  "productName": "Sine si Sosele",
  "version": "1.0.0",
  "description": "Minimalist traffic puzzle: roads, rails and growing towns.",
  "main": "main.js",
  "author": "Sine si Sosele",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win dir --x64",
    "dist:mac": "electron-builder --mac dir --universal",
    "dist:linux": "electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sinesisosele.game",
    "productName": "Sine si Sosele",
    "files": ["main.js", "game/**/*", "package.json"],
    "directories": { "output": "out", "buildResources": "build" },
    "win": { "target": "dir", "icon": "build/icon.png" },
    "mac": { "target": "dir", "icon": "build/icon.png", "category": "public.app-category.games" },
    "linux": { "target": "dir", "icon": "build/icon.png", "category": "Game" }
  }
}
